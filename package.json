{
  "name": "sarathg-me-web",
  "private": true,
  "version": "1.0.0",
  "description": "Static site for sarathg.me — Tailwind CSS build (replaces the cdn.tailwindcss.com script tag).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
